{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/personal-ai/knowledge-schema-v0.2.json",
  "title": "Personal AI Representative Knowledge Schema",
  "description": "Canonical schema for evidence-backed professional knowledge used by a Personal AI Representative.",
  "type": "object",
  "required": [
    "metadata",
    "entities",
    "facts",
    "skills",
    "projects",
    "sources",
    "relationships"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "subject_id",
        "generated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "0.2"
        },
        "subject_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date"
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    }
  },
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "private",
        "system"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_verification",
        "conflicted",
        "rejected"
      ]
    },
    "knowledge_type": {
      "type": "string",
      "enum": [
        "explicit",
        "derived",
        "inferred"
      ]
    },
    "source_ref": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "quote_or_excerpt": {
          "type": "string"
        },
        "reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "type",
        "reference_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "fact",
            "project",
            "role",
            "source",
            "artifact",
            "metric",
            "testimonial"
          ]
        },
        "reference_id": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "company",
            "institution",
            "role",
            "industry",
            "tool",
            "technology",
            "project",
            "location"
          ]
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "category",
        "knowledge_type",
        "confidence",
        "verification_status",
        "visibility",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "identity",
            "career",
            "education",
            "achievement",
            "responsibility",
            "preference",
            "working_style",
            "tool",
            "technology",
            "industry",
            "metric",
            "career_goal",
            "portfolio",
            "other"
          ]
        },
        "knowledge_type": {
          "$ref": "#/$defs/knowledge_type"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "confidence",
        "verification_status",
        "visibility",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "product",
            "creative",
            "leadership",
            "ai",
            "technical",
            "research",
            "strategy",
            "motion",
            "3d",
            "other"
          ]
        },
        "proficiency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "foundational",
            "working",
            "advanced",
            "expert",
            null
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "related_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "summary",
        "visibility",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "uri"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "prototype",
                  "document",
                  "link",
                  "other"
                ]
              },
              "uri": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "visibility": {
                "$ref": "#/$defs/visibility"
              }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "authority_level"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "cv",
            "portfolio",
            "case_study",
            "document",
            "ai_memory",
            "conversation",
            "manual",
            "analytics",
            "external"
          ]
        },
        "name": {
          "type": "string"
        },
        "authority_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from_id",
        "type",
        "to_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "worked_at",
            "held_role",
            "worked_on",
            "used_skill",
            "used_tool",
            "demonstrates_skill",
            "belongs_to_industry",
            "supported_by",
            "led",
            "managed",
            "contributed_to",
            "related_to"
          ]
        },
        "to_id": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "candidate_claim_ids",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "candidate_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "suggested_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}