# ---------------------------------------------------------------------------
# Model provider (Vercel AI SDK). The agent is provider-agnostic by design;
# set exactly one of these plus AGENT_MODEL_PROVIDER.
# ---------------------------------------------------------------------------
# One of: anthropic | openai | google
# Keep comments on their own line -- an inline "# ..." becomes part of the value.
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Persistence (Phase 7+). Left blank the app runs fully in-memory from
# /content, which is enough for the text-agent MVP.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Embedded artifacts
# ---------------------------------------------------------------------------
# Artifacts run with allow-same-origin because their runtime needs storage.
# Serving them from a separate origin is what makes that sandbox meaningful --
# set this in production to a distinct host or subdomain, and set APP_ORIGIN to
# the app's own origin so frame-ancestors still permits it.
# ARTIFACT_ORIGIN=https://artifacts.example.com
# APP_ORIGIN=https://example.com

# ---------------------------------------------------------------------------
# Observability (Phase 9)
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Realtime voice (PRD section 23)
# ---------------------------------------------------------------------------
# Voice uses the OpenAI Realtime API over WebRTC and needs OPENAI_API_KEY above,
# regardless of which provider AGENT_MODEL_PROVIDER selects for text. The key
# stays server-side; the browser only ever receives a short-lived ek_ secret.
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin

# ---------------------------------------------------------------------------
# Owner dashboard
# ---------------------------------------------------------------------------
# OWNER_DASHBOARD_PASSWORD=
