# ---------------------------------------------------------------------------
# Model provider (Vercel AI SDK). The agent is provider-agnostic by design;
# set exactly one of these plus AGENT_MODEL_PROVIDER.
# ---------------------------------------------------------------------------
# One of: anthropic | openai | google
# Keep comments on their own line -- an inline "# ..." becomes part of the value.
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Persistence (Phase 7+). Left blank the app runs fully in-memory from
# /content, which is enough for the text-agent MVP.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Observability (Phase 9)
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Voice (Phase 6)
# ---------------------------------------------------------------------------
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Owner dashboard
# ---------------------------------------------------------------------------
# OWNER_DASHBOARD_PASSWORD=
